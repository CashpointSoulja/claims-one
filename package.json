{
  "name": "claims-one",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An independent, synthetic pet-insurance triage reference on the TypeSafe AI System One contract.",
  "author": "Ayo Ahmed",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build-docs.mjs && vite",
    "build": "node scripts/build-docs.mjs && tsc -b && vite build && node scripts/check-package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint ."
  },
  "engines": { "node": ">=22.13.0" },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "marked": "^18.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
